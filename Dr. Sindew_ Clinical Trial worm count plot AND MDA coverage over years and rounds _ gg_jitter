############################################################
ONCHOCERCIASIS DATA VISUALIZATION PIPELINE
Mf DISTRIBUTION AND MDA COVERAGE ANALYSIS
############################################################
############################################################
1. LOAD REQUIRED LIBRARIES
############################################################
library(tidyverse)
library(ggplot2)
library(hrbrthemes)
library(plotly)
############################################################
2. MICROFILARIAE (Mf) LEFT VS RIGHT ANALYSIS
############################################################
Convert wide data to long format
CT1_long <- CT1 %>%
pivot_longer(
cols = c(Mf..left., Mf..right.),
names_to = "Side",
values_to = "Mf"
)
############################################################
3. COUNT SAMPLES WITH Mf > 100
############################################################
count_100 <- CT1_long %>%
group_by(Side) %>%
summarise(
n_over100 = sum(Mf > 100, na.rm = TRUE)
)
View counts
count_100
############################################################
4. BOXPLOT: LEFT VS RIGHT Mf DISTRIBUTION
############################################################
Mf_plot <- ggplot(
CT1_long,
aes(x = Side, y = Mf, fill = Side)
) +
Boxplot
geom_boxplot() +
Add sample counts >100
geom_text(
data = count_100,
aes(
x = Side,
y = max(CT1_long$Mf, na.rm = TRUE) * 1.05,
label = paste0("n >100 = ", n_over100)
),
inherit.aes = FALSE,
fontface = "bold"
) +

Custom colors
scale_fill_manual(
values = c(
"Mf..left." = "red",
"Mf..right." = "darkgreen"
)
) +
Theme
theme_classic() +
Labels
labs(
x = "Side",
y = "Mf count",
title = "Left vs Right Mf Count Distribution"
)
Display plot
plot(Mf_plot)
