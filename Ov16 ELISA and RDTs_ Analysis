make_heatmap_data <- function(tab, comparison) {

  as.data.frame(as.table(tab)) %>%
    setNames(c("reference", "comparator", "n")) %>%
    mutate(
      comparison = comparison,
      percentage = 100 * n / sum(n),
      label = paste0(
        format(n, big.mark = ","),
        "\n",
        sprintf("%.2f%%", percentage)
      )
    )
}

