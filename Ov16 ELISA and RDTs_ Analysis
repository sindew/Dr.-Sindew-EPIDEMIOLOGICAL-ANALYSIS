# ============================================================
# 6. AGREEMENT ANALYSIS FUNCTION
# ============================================================

agreement_analysis <- function(tab) {

  stopifnot(all(dim(tab) == c(2, 2)))

  n <- sum(tab)

  observed_agreement <- sum(diag(tab)) / n

  expected_agreement <- sum(
    rowSums(tab) * colSums(tab)
  ) / n^2

  kappa <- (
    observed_agreement - expected_agreement
  ) / (
    1 - expected_agreement
  )

  mcnemar <- mcnemar.test(
    tab,
    correct = TRUE
  )

  b <- tab[1, 2]
  c <- tab[2, 1]

  exact_mcnemar_p <- 2 * binom.test(
    min(b, c),
    b + c,
    p = 0.5
  )$p.value

  # Bound the doubled two-sided p-value at 1.
  exact_mcnemar_p <- min(exact_mcnemar_p, 1)

  positive_agreement <- (
    2 * tab[1, 1]
  ) / (
    2 * tab[1, 1] + tab[1, 2] + tab[2, 1]
  )

  negative_agreement <- (
    2 * tab[2, 2]
  ) / (
    2 * tab[2, 2] + tab[1, 2] + tab[2, 1]
  )

  tibble(
    n = n,
    positive_positive = tab[1, 1],
    positive_negative = tab[1, 2],
    negative_positive = tab[2, 1],
    negative_negative = tab[2, 2],
    observed_agreement = 100 * observed_agreement,
    kappa = kappa,
    positive_agreement = 100 * positive_agreement,
    negative_agreement = 100 * negative_agreement,
    mcnemar_chisq = unname(mcnemar$statistic),
    mcnemar_p = mcnemar$p.value,
    exact_mcnemar_p = exact_mcnemar_p
  )
}


