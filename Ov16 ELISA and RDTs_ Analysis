  )
)

fisher_elisa_dbs <- fisher.test(
  matrix(
    c(654, 9320,
      377, 9489),
    nrow = 2,
    byrow = TRUE,
    dimnames = list(
      c("ELISA_DBS", "RDT_DBS"),
      c("Positive", "Negative")
    )
  )
)

fisher_whole_dbs <- fisher.test(
  matrix(
    c(201, 9773,
      377, 9489),
    nrow = 2,
    byrow = TRUE,
    dimnames = list(
      c("RDT_whole_blood", "RDT_DBS"),
